<?xml version="1.0"?>
<robot name="robot_rrr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== BASE ===================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.2 0.2 0.05"/>
      </geometry>
      <origin xyz="0 0 -0.025"/>
      <material name="purple">
        <color rgba="0.25 0 0.6 1"/>
      </material>
    </visual>
  </link>

  <!-- ===================== SHOULDER ===================== -->
  <!--
    shoulder_joint: rotación en Z (yaw = th1)
    → apunta el plano vertical del brazo hacia el objetivo XY
    Origen: (0, 0, 0) en base_link
  -->
  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry>
        <box size="0.05 0.05 0.20"/>
      </geometry>
      <material name="green">
        <color rgba="0 0.5 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="20" velocity="1"/>
    <dynamics damping="0.1"/>
  </joint>

  <!-- ===================== ARM ===================== -->
  <!--
    arm_joint: rotación en Y (pitch = th2)
    → inclina el brazo en el plano vertical apuntado por th1
    Origen: (0, 0, 0.20) en shoulder_link  [l1 = 0.20 m]
  -->
  <link name="arm_link">
    <visual>
      <origin xyz="0 0 0.175"/>
      <geometry>
        <box size="0.05 0.05 0.35"/>
      </geometry>
      <material name="red">
        <color rgba="0.6 0 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="arm_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="arm_link"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    <dynamics damping="0.1"/>
  </joint>

  <!-- ===================== FOREARM ===================== -->
  <!--
    forearm_joint: rotación en Y (pitch = th3)
    → inclina el antebrazo relativo al brazo
    Origen: (0, 0, 0.35) en arm_link  [l2 = 0.35 m]
  -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry>
        <box size="0.05 0.05 0.50"/>
      </geometry>
      <material name="orange">
        <color rgba="0.8 0.4 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="forearm_joint" type="revolute">
    <parent link="arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.35" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    <dynamics damping="0.1"/>
  </joint>

  <!-- ===================== END EFFECTOR (visual) ===================== -->
  <link name="end_effector_link">
    <visual>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
  </link>

  <joint name="end_effector_joint" type="fixed">
    <parent link="forearm_link"/>
    <child link="end_effector_link"/>
    <origin xyz="0 0 0.50" rpy="0 0 0"/>  <!-- l3 = 0.50 m -->
  </joint>

</robot>
