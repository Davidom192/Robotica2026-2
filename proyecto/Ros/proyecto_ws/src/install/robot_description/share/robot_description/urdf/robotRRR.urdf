<?xml version="1.0"?>
<robot name="robot_rrr">

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.05"/>
      </geometry>
      <origin xyz="0 0 -0.025"/>
      <material name="yellow">
        <color rgba="0.9 0.9 0 1"/>
      </material>
    </visual>
  </link>

  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.085"/>
      <geometry>
        <box size="0.05 0.05 0.17"/>
      </geometry>
      <material name="green">
        <color rgba="0 0.8 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="20" velocity="1"/>
    <dynamics damping="0.1"/>
  </joint>

  <link name="arm_link">
    <visual>
      <origin xyz="0 0 0.115"/>
      <geometry>
        <box size="0.05 0.05 0.23"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
  </link>

  <joint name="arm_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="arm_link"/>
    <origin xyz="0 0 0.17" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
    <dynamics damping="0.1"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.185"/>
      <geometry>
        <box size="0.05 0.05 0.37"/>
      </geometry>
      <material name="red_forearm">
        <color rgba="0.8 0 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="forearm_joint" type="revolute">
    <parent link="arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.23" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
    <dynamics damping="0.1"/>
  </joint>

  <link name="end_effector_link">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="yellow"/>
    </visual>
  </link>

  <joint name="end_effector_joint" type="fixed">
    <parent link="forearm_link"/>
    <child link="end_effector_link"/>
    <origin xyz="0 0 0.37" rpy="0 0 0"/>
  </joint>

</robot>